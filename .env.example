# Resend API key used by src/app/api/contact/route.ts (SPR-009, the Contact
# section) to deliver visitor messages. Get one at https://resend.com/api-keys
RESEND_API_KEY=

# Set to "true" locally to bypass Resend entirely and simulate a successful
# submission (with a realistic delay) — lets you exercise Scope's full
# accept/departure sequence without a real API key. Never set in production.
CONTACT_SIMULATE_SUCCESS=
