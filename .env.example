# Resend API key used by src/lib/email/resend.tsx (SPR-009/SPR-010, the
# Contact section) to deliver visitor messages and the visitor's own
# confirmation reply. Get one at https://resend.com/api-keys
RESEND_API_KEY=

# The site owner's own inbox — where the internal "new message" notification
# is delivered (the "to" address of that email; see sendContactEmail in
# src/lib/email/resend.tsx). Any real mailbox works, no domain verification
# needed for this one.
CONTACT_TO_EMAIL=contact@alvarogaertner.com

# The verified sending identity for both emails Resend sends (internal
# notification + visitor confirmation) — format is `Name <address@domain>`.
# The domain in the address MUST be verified in the Resend dashboard first
# (see README.md for how); until then, Resend will reject sends from it.
CONTACT_FROM_EMAIL=Scope <contact@alvarogaertner.com>

# Set to "true" locally to bypass Resend entirely and simulate a successful
# submission (with a realistic delay) — lets you exercise Scope's full
# accept/departure sequence without a real API key. Never set in production.
CONTACT_SIMULATE_SUCCESS=
